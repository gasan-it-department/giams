# ═══════════════════════════════════════════════════════════════════════════
#  GIAMS — office node configuration
#
#  Copy to `.env` and edit. Never commit the filled-in copy: it carries the
#  signing secret for every session on this installation.
#
#  Values containing spaces MUST be quoted. An unquoted value with a space in
#  it silently truncates the rest of the file — this bit us once, on
#  GIAMS_MUNICIPALITY.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# The office's PostgreSQL server. On the node this is normally localhost.
DATABASE_URL="postgresql://giams:CHANGE-ME@localhost:5432/giams"

# ── This server ─────────────────────────────────────────────────────────────
# 127.0.0.1 accepts only this machine. To let workstations on the office LAN
# reach it, use 0.0.0.0 — and put it behind the TLS terminator first.
GIAMS_BIND="127.0.0.1:8787"

GIAMS_TENANT_CODE="GASAN"
GIAMS_MUNICIPALITY="Municipality of Gasan"
GIAMS_NODE_CODE="ACCTG-01"

# The municipality's id, from its licence profile's server settings. Only
# matters on a fresh installation, where it makes a licence key issued for this
# municipality in advance install here. Leave blank to have one generated.
# GIAMS_TENANT_ID=""

# ── Renewals ────────────────────────────────────────────────────────────────
# The licensing server's address. This server checks it every six hours (and
# when someone chooses Check for renewal) and collects any renewal recorded
# there, so the office never has to install a new key. Leave blank and a
# renewal can only arrive as a pasted key.
# GIAMS_LICENCE_SERVER="https://licensing.example.gov.ph"

# ── Licensing authority (the vendor's server only) ──────────────────────────
# Path to the licensing authority's private key. With it, Admin → Licences can
# issue keys. A municipality's server must NEVER have this: anyone holding it
# can issue a key for any municipality.
# GIAMS_LICENCE_AUTHORITY_KEY="C:/ProgramData/GIAMS/licensing/authority.key"

# ── Session signing ─────────────────────────────────────────────────────────
# No default, deliberately: a secret that ships in the source is not a secret.
# Generate a fresh one per installation:
#     openssl rand -base64 48
GIAMS_TOKEN_SECRET="CHANGE-ME-generate-a-new-one-for-every-installation"

# Where this node's Ed25519 signing key is kept. It proves that batches
# uploaded to the cloud came from this server. Back it up somewhere other than
# this machine, and never commit it.
# GIAMS_NODE_KEY_PATH="C:/ProgramData/GIAMS/node-signing.key"

# ── Cloud copy (optional) ───────────────────────────────────────────────────
# Leave blank and nothing is uploaded; the office keeps its books either way.
GIAMS_CLOUD_URL=""

# Held by whoever operates the cloud service. Without it a node cannot
# register, which is what stops anyone replacing a municipality's signing key.
GIAMS_CLOUD_ENROLMENT_SECRET=""

# Off unless asked for. An office that has not been told its data leaves the
# building should not discover that it does.
GIAMS_UPLOAD_AUTOMATICALLY="false"

# Records per upload. Lower on a slow or metered connection, where a failed
# large batch wastes the whole transfer.
# GIAMS_UPLOAD_BATCH_SIZE="500"

# ── Encryption (TLS) ────────────────────────────────────────────────────────
# Leave blank and the node serves plain HTTP — acceptable on a switched office
# LAN, and nowhere else. Create a certificate with:
#     giams-node make-cert 192.168.1.25
# then set both lines and restart. Every workstation must trust the .crt once,
# under Trusted Root Certification Authorities, or it will warn on every visit.
GIAMS_TLS_CERT=""
GIAMS_TLS_KEY=""

# ── Logging ─────────────────────────────────────────────────────────────────
# `debug` while commissioning; `info` in normal service.
# RUST_LOG="giams=info,tower_http=warn,sqlx=warn"
