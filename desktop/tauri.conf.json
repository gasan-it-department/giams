{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GIAMS",
  "version": "0.1.0",
  "identifier": "ph.gov.gasan.giams",

  "build": {
    "beforeDevCommand": "npm --prefix client run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm --prefix client run build",
    "frontendDist": "../client/dist"
  },

  "app": {
    "windows": [
      {
        "title": "GIAMS — Municipality of Gasan",
        "width": 1366,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https:",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "freezePrototype": false
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Municipality of Gasan",
    "copyright": "Municipality of Gasan, Marinduque",
    "shortDescription": "Accounting Management System",
    "longDescription": "Gasan Integrated Accounting Management System — general ledger, budget execution, bank reconciliation, and financial statements for the Municipal Accounting Office.",
    "windows": {
      "allowDowngrades": false
    }
  }
}
